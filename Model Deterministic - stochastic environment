      "source": [
        "import random\n",
        "import statistics\n",
        "\n",
        "random.seed(42)  # reproducible run\n",
        "\n",
        "ACTIONS = {'U': (-1, 0), 'D': (1, 0), 'L': (0, -1), 'R': (0, 1)}\n",
        "\n",
        "def clamp(v, lo, hi):\n",
        "    return max(lo, min(v, hi))\n",
        "\n",
        "def choose_action(state, goal):\n",
        "    \"\"\"Simple reflex agent: reduce Manhattan distance to goal.\"\"\"\n",
        "    r, c = state\n",
        "    gr, gc = goal\n",
        "    if r < gr: return 'D'\n",
        "    if r > gr: return 'U'\n",
        "    if c < gc: return 'R'\n",
        "    if c > gc: return 'L'\n",
        "    return None"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "def step(state, action, grid_size, stochastic=False, p=0.8):\n",
        "    \"\"\"Deterministic by default. If stochastic=True, the intended\n",
        "    action succeeds with probability p; otherwise a random action\n",
        "    is substituted (models environment uncertainty).\"\"\"\n",
        "    if stochastic and random.random() > p:\n",
        "        action = random.choice(list(ACTIONS.keys()))\n",
        "    dr, dc = ACTIONS[action]\n",
        "    r, c = state\n",
        "    nr = clamp(r + dr, 0, grid_size - 1)\n",
        "    nc = clamp(c + dc, 0, grid_size - 1)\n",
        "    return (nr, nc)"
      ],
      "metadata": {
        "id": "1zv-opvAMuJC"
      },
      "execution_count": 12,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def run_episode(grid_size, start, goal, stochastic=False, p=0.8, max_steps=200):\n",
        "    state = start\n",
        "    steps = 0\n",
        "    while state != goal and steps < max_steps:\n",
        "        action = choose_action(state, goal)\n",
        "        state = step(state, action, grid_size, stochastic, p)\n",
        "        steps += 1\n",
        "    return steps"
      ],
      "metadata": {
        "id": "DVDW3x7KMxxN"
      },
      "execution_count": 13,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def run_trials(n, grid_size, start, goal, stochastic=False, p=0.8):\n",
        "    return [run_episode(grid_size, start, goal, stochastic, p) for _ in range(n)]"
      ],
      "metadata": {
        "id": "Si41PJp0M0Up"
      },
      "execution_count": 14,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "if __name__ == \"__main__\":\n",
        "    GRID_SIZE, START, GOAL, N_RUNS = 5, (0, 0), (4, 4), 20\n",
        "    det = run_trials(N_RUNS, GRID_SIZE, START, GOAL, stochastic=False)\n",
        "    sto = run_trials(N_RUNS, GRID_SIZE, START, GOAL, stochastic=True, p=0.8)\n",
        "    print('Run\\tDeterministic\\tStochastic(p=0.8)')\n",
        "    for i in range(N_RUNS):\n",
        "        print(f'{i+1}\\t{det[i]}\\t\\t{sto[i]}')\n",
        "    print('Deterministic mean:', statistics.mean(det), 'stdev:', statistics.pstdev(det))\n",
        "    print('Stochastic    mean:', statistics.mean(sto), 'stdev:', statistics.pstdev(sto))"
      ],
